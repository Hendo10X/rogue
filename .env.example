# =============================================================================
# Rogue — environment variables
#
# The production app already has its secrets configured on the host (Vercel).
# This file documents the variables the app reads so you know what to set.
#
# The ONLY new variables required for the features added in this branch are the
# Google sign-in credentials below — everything else is already live in prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Sign-In (NEW — required for "Continue with Google")
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorised redirect URI (add for every domain you use):
#   https://YOUR_DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local dev)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Core / auth (already set in production)
# -----------------------------------------------------------------------------
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=
# Fallback FX rate used only if the live exchange-rate API is unreachable
NEXT_PUBLIC_USD_TO_NGN=1600

# -----------------------------------------------------------------------------
# Boosting / SMM providers (already set in production)
# -----------------------------------------------------------------------------
SOCIALLY_API_KEY=
RESELLER_PROVIDER_API_KEY=
REALLYSIMPLESOCIAL_API_KEY=

# -----------------------------------------------------------------------------
# Payment providers (already set in production)
# -----------------------------------------------------------------------------
PLISIO_API_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Notifications (already set in production)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
