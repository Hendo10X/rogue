[Unit]
Description=Rogue Socials (Next.js)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/rogue
Environment=NODE_ENV=production
# next start reads /opt/rogue/.env itself.
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
